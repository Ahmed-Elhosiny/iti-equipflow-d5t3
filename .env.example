# Environment
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# Database (Docker Compose)
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=equipflow;Username=equipflow;Password=equipflow_password

# Database (Local Development - without Docker)
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=equipflow;Username=equipflow;Password=equipflow_password

# LLM Provider Configuration
# Options: OpenAI, Ollama, Mock
LlmProvider=Ollama

# Ollama Configuration (Local/Free)
Ollama__BaseUrl=http://localhost:11434
Ollama__ChatModel=qwen2.5:7b-instruct
Ollama__EmbeddingModel=mxbai-embed-large

# OpenAI Configuration (Hosted API - requires API key)
OpenAI__ApiKey=REPLACE_ME_WITH_YOUR_OPENAI_API_KEY
OpenAI__Model=gpt-4o-mini
OpenAI__BaseUrl=https://api.openai.com/v1

# Mock Provider Configuration (for testing without LLM calls)
Mock__Enabled=true

# Cost Governor (T3 Twist)
CostGovernor__DefaultMonthlyTokenBudget=100000
CostGovernor__HardCutOff=true
CostGovernor__SafetyMargin=1.2

# JWT Authentication
Jwt__Key=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
Jwt__Issuer=EquipFlow
Jwt__Audience=EquipFlowUsers
Jwt__ExpirationInMinutes=60

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# Database
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=equipflow;Username=equipflow;Password=equipflow_password

# LLM Provider (Ollama as default free tier)
LlmProvider=Ollama
Ollama__BaseUrl=http://localhost:11434
Ollama__ChatModel=qwen2.5:7b-instruct
Ollama__EmbeddingModel=nomic-embed-text

# Cost Governor (T3 Twist)
CostGovernor__DefaultMonthlyTokenBudget=100000
CostGovernor__HardCutOff=true

# Security
Jwt__Secret=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS